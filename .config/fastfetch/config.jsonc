{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": ": ",
    "key": { "width": 12 },
    "color": { "keys": "blue" }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "terminal", "key": "Terminal", "format": "{pretty-name}" },
    { "type": "terminalfont", "key": "Font" },
    { "type": "wm", "key": "WM", "format": "{pretty-name}" },
    { "type": "display", "key": "Display", "format": "{width}x{height} @{refresh-rate}Hz" },
    { "type": "cpu", "key": "CPU", "format": "{name}" },
    { "type": "cpuusage", "key": "CPU Usage" },
    { "type": "gpu", "key": "GPU", "format": "{name}" },
    "memory",
    "swap",
    { "type": "disk", "folders": "/", "key": "Disk", "format": "{1} / {2} ({3})" },
    { "type": "battery", "key": "Battery", "format": "{capacity}" },
    { "type": "localip", "key": "Local IP", "format": "{ipv4}" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
